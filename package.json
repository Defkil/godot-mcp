{
  "name": "@defkil/godot-mcp",
  "version": "4.0.0",
  "description": "MCP server for full Godot 4.x engine control with 158 tools for AI-driven game development",
  "keywords": [
    "godot",
    "mcp",
    "ai",
    "claude",
    "cline",
    "game-engine",
    "gdscript",
    "runtime",
    "model-context-protocol"
  ],
  "homepage": "https://github.com/Defkil/godot-mcp",
  "bugs": {
    "url": "https://github.com/Defkil/godot-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Defkil/godot-mcp.git"
  },
  "mcpName": "io.github.Defkil/godot-mcp",
  "license": "MIT",
  "author": "Defkil (https://github.com/Defkil)",
  "contributors": [
    "Tugcan Topaloglu (https://github.com/tugcantopaloglu) — immediate upstream author of the 158-tool fork",
    "Solomon Elias <solomon@sippy.ai> (https://github.com/Coding-Solo) — original godot-mcp author"
  ],
  "type": "module",
  "bin": {
    "godot-mcp": "./build/bin.js"
  },
  "exports": {
    ".": {
      "import": "./build/index.js"
    }
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && node scripts/build.js",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js",
    "prepare": "npm run build",
    "version": "node scripts/sync-version.js && git add package-lock.json server.json",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.26.0",
    "axios": "^1.16.0",
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.3.3",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
