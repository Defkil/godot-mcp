{
  "name": "gi-go-mcp",
  "version": "3.1.0",
  "description": "gi-go-mcp — Gizmos Godot MCP",
  "keywords": [
    "godot",
    "mcp",
    "ai",
    "claude",
    "cline",
    "game-engine",
    "gdscript",
    "runtime",
    "model-context-protocol"
  ],
  "homepage": "https://github.com/Defkil/gi-go-mcp",
  "bugs": {
    "url": "https://github.com/Defkil/gi-go-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Defkil/gi-go-mcp.git"
  },
  "mcpName": "io.github.defkil/gi-go-mcp",
  "license": "MIT",
  "author": "Oliver Grüttner",
  "contributors": [
    "Tugcan Topaloglu",
    "Solomon Elias <solomon@sippy.ai> (https://github.com/Coding-Solo)"
  ],
  "type": "module",
  "bin": {
    "gi-go-mcp": "./build/bin.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && node scripts/build.js",
    "inspector": "npx @modelcontextprotocol/inspector build/bin.js",
    "prepare": "npm run build",
    "version": "node scripts/sync-version.js && git add package-lock.json server.json",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^3.2.6",
    "typescript": "^5.3.3",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
